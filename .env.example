# Copy to .env and fill in. Never commit .env.
ADMIN_TOKEN=change-me-long-random-string
OPENAI_API_KEY=            # optional; without it the app answers extractively from sources
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ALLOWED_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MIN=20
DATABASE_PATH=data/ajanta.db
CONTACT_EMAIL=ajantaluhana@gmail.com   # shown in fallback answers and Hire flow
